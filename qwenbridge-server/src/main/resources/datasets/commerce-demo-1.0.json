  "expectations": [
    {
      "name": "every-constraint",
      "query": "black Nike shoes size 42 under 100 EUR not refurbished in stock",
      "constraints": [
        [
          "brand",
          "EQ",
          "Nike"
        ],
        [
          "color",
          "EQ",
          "black"
        ],
        [
          "size",
          "EQ",
          "42"
        ],
        [
          "price",
          "LT",
          "100"
        ],
        [
          "currency",
          "EQ",
          "EUR"
        ],
        [
          "condition",
          "NE",
          "refurbished"
        ],
        [
          "inStock",
          "EQ",
          "true"
        ]
      ],
      "expected": [
        "demo-shoe-01",
        "demo-shoe-10",
        "demo-shoe-12",
        "demo-shoe-13"
      ],
      "why": "Only products meeting every constraint; 02 refurbished, 03 and 11 not under 100, 04 white, 05 Adidas, 06 out of stock, 07 size 43, 08 SEK, 09 condition unstated.",
      "contract": "apiVersion 2 (no contract)"
    },
    {
      "name": "every-constraint-planned",
      "contract": "commerce-search/1.0",
      "query": "black Nike shoes size 42 under 100 EUR not refurbished in stock",
      "constraints": [
        [
          "brand",
          "EQ",
          "Nike"
        ],
        [
          "color",
          "EQ",
          "black"
        ],
        [
          "size",
          "EQ",
          "42"
        ],
        [
          "price",
          "LT",
          "100"
        ],
        [
          "currency",
          "EQ",
          "EUR"
        ],
        [
          "condition",
          "NE",
          "refurbished"
        ],
        [
          "inStock",
          "EQ",
          "true"
        ]
      ],
      "expected": [
        "demo-shoe-01",
        "demo-shoe-09",
        "demo-shoe-10",
        "demo-shoe-12",
        "demo-shoe-13"
      ],
      "why": "Same query under the planned contract. Neutral filter semantics (ADR 0025): an exclusion (condition NE refurbished) keeps documents that lack the field, so demo-shoe-09 (condition unstated) is included; apiVersion 2 requires a stated condition and excludes it."
    },
    {
      "name": "brand-and-category",
      "query": "Osprey backpack",
      "constraints": [
        [
          "brand",
          "EQ",
          "Osprey"
        ]
      ],
      "expected": [
        "demo-bag-01"
      ],
      "why": "One Osprey product."
    }
  ]
