JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"

QWENBRIDGE_AI_PROVIDER=ollama
QWENBRIDGE_AI_OLLAMA_BASE_URL=http://qwenbridge-ollama:11434
QWENBRIDGE_AI_OLLAMA_CHAT_MODEL=qwen2.5
QWENBRIDGE_AI_OLLAMA_EMBEDDING_MODEL=bge-m3

# Local Docker model residency; tested with an 8 CPU / 24 GB Docker Desktop VM.
OLLAMA_MEMORY_LIMIT=12g
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=1
OPENSEARCH_MEMORY_LIMIT=2g
QUARKUS_REDIS_MAX_POOL_SIZE=32
QUARKUS_REDIS_MAX_POOL_WAITING=1024

# Compact schema-constrained analysis is the default. False restores the legacy prompt.
QWENBRIDGE_ANALYSIS_COMPACT_OUTPUT=true
# Vector search still uses embeddings internally; result documents omit their large arrays.
QWENBRIDGE_SEARCH_OPENSEARCH_INCLUDE_EMBEDDINGS_IN_RESULTS=false

QWENBRIDGE_SEARCH_OPENSEARCH_BASE_URL=http://qwenbridge-opensearch:9200
QWENBRIDGE_ANALYSIS_CACHE_REDIS_HOST=qwenbridge-redis
QWENBRIDGE_ANALYSIS_CACHE_REDIS_PORT=6379
QWENBRIDGE_ANALYSIS_CACHE_ANALYSIS_TIMEOUT=120s

QWENBRIDGE_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Docker uses the Quarkus docker profile; workstation development can use local.
QUARKUS_PROFILE=docker
QWENBRIDGE_AI_OLLAMA_STREAMING_ENABLED=true

# Tenant-aware API v2. Keep credentials out of source control and client bundles.
QWENBRIDGE_SECURITY_AUTHENTICATION_REQUIRED=false
QWENBRIDGE_SECURITY_API_PRINCIPALS=[]
# Configure principals in the secret environment as a JSON array:
# [{"key":"<at least 24 random characters>","subject":"alice","tenant":"shop-a","roles":["search"]}]
# Administrative roles: schema:write, catalog:write, analytics:read, analytics:write,
# evidence:read, evidence:write, plugins:read. Tenant and subject come from this mapping.

# Optional service credentials and trusted CA for a secured OpenSearch deployment.
# QWENBRIDGE_SEARCH_OPENSEARCH_USERNAME=
# QWENBRIDGE_SEARCH_OPENSEARCH_PASSWORD=
# QWENBRIDGE_SEARCH_OPENSEARCH_BEARER_TOKEN=
# QUARKUS_REST_CLIENT_OPENSEARCH_TLS_CONFIGURATION_NAME=search
# QUARKUS_TLS_SEARCH_TRUST_STORE_P12_PATH=/run/secrets/opensearch-truststore.p12
# QUARKUS_TLS_SEARCH_TRUST_STORE_P12_PASSWORD=<secret>

# Optional second AI provider: documented QwenBridge HTTP JSON gateway protocol.
# QWENBRIDGE_AI_PROVIDER=http-json
# QWENBRIDGE_AI_HTTP_JSON_BASE_URL=https://ai-gateway.example
# QWENBRIDGE_AI_HTTP_JSON_TOKEN=<secret>

# Optional trusted external JARs and reranker extension.
# QWENBRIDGE_PLUGINS_DIRECTORY=/opt/qwenbridge/plugins
# QWENBRIDGE_COMMERCE_RERANKER_PLUGIN=my-ranker
QWENBRIDGE_COMMERCE_RERANK_TIMEOUT_MS=3000

# Catalog synchronization is disabled until an operator configures a source.
QWENBRIDGE_CATALOG_KIND=http-json
# QWENBRIDGE_CATALOG_ENDPOINT=https://catalog.example/changes
# QWENBRIDGE_CATALOG_TOKEN=<secret>
# Catalog synchronization keeps its checkpoint and lock in Redis (QUARKUS_REDIS_HOSTS); without Redis
# a sync request is refused with 503. Search itself never needs Redis.

# Search backends. The default is in-process (no database, no search engine): keyword, vector and
# hybrid retrieval. OpenSearch is the only built-in optional backend (QB-287).
# QWENBRIDGE_SEARCH_BACKEND=in-memory       # v1 retrieval: in-memory (default) | opensearch
# QWENBRIDGE_COMMERCE_BACKEND=memory        # v2 Commerce: memory (default) | opensearch
# Redis persists owned sessions, signed licenses, pack state and the local marketplace.
# QWENBRIDGE_PLATFORM_PERSISTENT=true
# Trust maps contain key ID -> Base64 X.509 Ed25519 PUBLIC key, never private keys.
# QWENBRIDGE_LICENSING_TRUSTED_KEYS={"issuer":"public-key-base64"}
# QWENBRIDGE_PACKS_TRUSTED_PUBLISHERS={"publisher":"public-key-base64"}
# Explicit environment-variable allowlist for pack configuration env:NAME references.
# QWENBRIDGE_PACKS_ALLOWED_SECRET_ENV=CATALOG_API_TOKEN

# QwenBridge 1.0 conversation context (ADR 0035)
# QWENBRIDGE_PLATFORM_STORE=file           # memory (default) | file (durable, with QWENBRIDGE_PLATFORM_FILE_DIR) | redis (shared, several instances)
# QWENBRIDGE_PLATFORM_MAX_VALUE_BYTES=1048576
# QWENBRIDGE_CONTEXT_TTL=30m               # at most 1h
# Optional signed context tokens (Ed25519, base64 PKCS#8 / X.509); without them no tokens are issued.
# QWENBRIDGE_CONTEXT_SIGNING_KEY_ID=context-1
# QWENBRIDGE_CONTEXT_SIGNING_PRIVATE_KEY=<operator-managed secret>
# QWENBRIDGE_CONTEXT_SIGNING_PUBLIC_KEY=<base64 X.509>

# Built-in backend guard (ADR 0037): circuit breaker and call timeout for memory/opensearch.
# QWENBRIDGE_CONNECTORS_CIRCUIT_FAILURE_THRESHOLD=5
# QWENBRIDGE_CONNECTORS_CIRCUIT_OPEN_FOR=30s
# Connector Packs (none ship with QwenBridge 1.0; the extension point for separately installed
# packs): credentials are secret references only, e.g. env:MY_PASSWORD or file:/run/secrets/x.
# QWENBRIDGE_CONNECTOR_PACKS_ENABLED=my-pack
# QWENBRIDGE_CONNECTOR_PACKS_SECRETS_DIR=/run/secrets

# v2 API limits (ADR 0040)
# QWENBRIDGE_API_REQUEST_TIMEOUT=60s       # deadline per request; clients may ask for less (X-Request-Timeout-Ms)
# QWENBRIDGE_API_MAX_PAGE_SIZE=100         # 1..100
# QWENBRIDGE_API_SSE_HEARTBEAT=15s

# Developer Playground demo data (ADR 0043): only with QWENBRIDGE_COMMERCE_BACKEND=memory
# QWENBRIDGE_DEMO_DATASETS=commerce-demo
# QWENBRIDGE_DEMO_TENANT=public

# Typo detection and correction (QB-291). Off by default; no language is assumed.
# QWENBRIDGE_TYPO_ENABLED=true
# QWENBRIDGE_TYPO_LANGUAGES=en,sv            # any BCP 47 identifiers; each needs an installed provider
# QWENBRIDGE_TYPO_MODE=SAFE_AUTO_CORRECT     # DISABLED | SUGGEST_ONLY (default) | SAFE_AUTO_CORRECT | AGGRESSIVE
# QWENBRIDGE_TYPO_DICTIONARY_DIR=/opt/qwenbridge/typo   # <bcp47>.txt word lists, optional domain.txt
# QWENBRIDGE_TYPO_TENANTS={"shop-se":{"enabled":true,"languages":["sv"],"mode":"SAFE_AUTO_CORRECT"}}

# Multilingual query expansion (QB-286). Off by default; no target language and no provider is assumed.
# QWENBRIDGE_MULTILINGUAL_ENABLED=true
# QWENBRIDGE_MULTILINGUAL_TARGET_LANGUAGES=en,fa,sv,nb,nn   # any BCP 47 identifiers; one result each
# QWENBRIDGE_MULTILINGUAL_POLICY=ALL_TARGETS                # ALL_TARGETS | STRICT_ALL_TARGETS | BEST_EFFORT_ALL_TARGETS
# QWENBRIDGE_MULTILINGUAL_PROVIDERS=glossary,model          # glossary: phrase tables; model: the local chat model
# QWENBRIDGE_MULTILINGUAL_GLOSSARY_DIR=/opt/qwenbridge/glossary   # <source>_to_<target>.tsv tables
# QWENBRIDGE_MULTILINGUAL_TENANTS={"shop-b":{"enabled":true,"targetLanguages":["de","fr"]}}
