JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError"

QWENBRIDGE_AI_PROVIDER=ollama
QWENBRIDGE_AI_OLLAMA_BASE_URL=http://qwenbridge-ollama:11434
QWENBRIDGE_AI_OLLAMA_CHAT_MODEL=qwen2.5
QWENBRIDGE_AI_OLLAMA_EMBEDDING_MODEL=bge-m3

QWENBRIDGE_SEARCH_OPENSEARCH_BASE_URL=http://qwenbridge-opensearch:9200
QWENBRIDGE_ANALYSIS_CACHE_REDIS_HOST=qwenbridge-redis
QWENBRIDGE_ANALYSIS_CACHE_REDIS_PORT=6379
QWENBRIDGE_ANALYSIS_CACHE_ANALYSIS_TIMEOUT=10s
