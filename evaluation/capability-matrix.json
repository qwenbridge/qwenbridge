{
  "version": "1.0",
  "description": "Query capability test matrix (QB-208). Each entry is a test class#method; CapabilityMatrixTest fails if a referenced test does not exist. 'gaps' lists missing coverage explicitly.",
  "capabilities": [
    {
      "id": "exact",
      "description": "Exact terms and exact constraint values",
      "positive": [
        "RetrievalPrimitivesTest#comparisonsAreExactAndTyped",
        "SyntheticCatalogSearchTest#returnsExactlyTheProductsThatSatisfyEveryConstraintWithinTheTenant",
        "KeywordQualityBaselineTest#keywordQualityIsMeasuredReproduciblyAndWritten"
      ],
      "negative": [
        "ConstraintExtractorTest#bareNumbersAreNeverInventedIntoConstraints",
        "CommerceCompilerTest#rejectsUnsupportedFieldsCurrenciesOperatorsAndContradictions"
      ],
      "degradation": [
        "ServiceFreeE2ETest#errorPathsFailClosedAndTyped"
      ],
      "gaps": []
    },
    {
      "id": "structured",
      "description": "Filters without free text, and hard constraints",
      "positive": [
        "PlanningTest#structuredOnlyQueriesBrowseByFilter",
        "CommercePlanningTest#structuredOnlyQueriesBrowseByFilterWithoutEmbedding",
        "LibraryDatasetTest#everyCaseReproducesItsExpectedResult"
      ],
      "negative": [
        "PlanningTest#anUncompilableHardConstraintFailsTheWholeQueryNeverDropped",
        "CommercePlanningTest#dateConstraintsAreRefusedAsUnsupportedNeverDropped"
      ],
      "degradation": [
        "StructuredQueryCoordinatorTest#refusesUnfilteredStructuredExecution",
        "OpenSearchTimeoutIntegrationTest#slowHttpBackendTimesOutBeforeItsResponseCompletes"
      ],
      "gaps": []
    },
    {
      "id": "semantic",
