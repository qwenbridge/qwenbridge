      ],
      "negative": [
        "RetrievalPrimitivesTest#vectorsFromAnotherSpaceAreNeverCompared",
        "AIServiceEmbeddingProviderTest#aModelThatChangedItsDimensionsIsDetectedNotMixedIn"
      ],
      "degradation": [
        "CommercePlanningTest#unavailableSemanticsDegradeVisiblyToKeyword",
        "AIServiceEmbeddingProviderTest#anUnavailableModelIsATypedFailureAndDisabledMeansNoProvider"
      ],
      "gaps": []
    },
    {
      "id": "hybrid",
      "description": "Keyword and vector fused (RRF)",
      "positive": [
        "PlanningTest#hybridPlansExecuteWithVectors",
        "RetrievalQualityEvaluationTest#keywordVectorAndHybridAreMeasuredOnTheSameHeldOutQueries"
      ],
      "negative": [
        "OpenSearchStructuredQueryFactoryTest#rejectsVectorSearchRatherThanDroppingFilters",
