<?xml version="1.0" encoding="UTF-8"?>
<!--
  QB-295: independent Java 25 consumer of the public QwenBridge Java SDK. Deliberately NOT a module
  of the QwenBridge reactor: it resolves the SDK as an external Maven dependency (installed into the
  local repository by the orchestrator) and uses only its public API, over real HTTP.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.qwenbridge.e2e</groupId>
  <artifactId>dual-sdk-java-consumer</artifactId>
  <version>1.0.0-RC1</version>
  <packaging>jar</packaging>
  <name>QwenBridge dual-SDK E2E Java consumer</name>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <qwenbridge.sdk.version>1.0.0-RC1</qwenbridge.sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.qwenbridge</groupId>
      <artifactId>qwenbridge-java-sdk</artifactId>
      <version>${qwenbridge.sdk.version}</version>
    </dependency>
  </dependencies>
</project>
