<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.qwenbridge</groupId>
    <artifactId>qwenbridge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>QwenBridge Parent</name>
    <description>QwenBridge developer platform and SDK ecosystem</description>

    <modules>
        <module>qwenbridge-server</module>
        <module>qwenbridge-java-sdk</module>
        <module>qwenbridge-spring-boot-starter</module>
        <module>examples/java-sdk-example</module>
        <module>examples/spring-boot-starter-example</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

</project>
